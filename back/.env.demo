NODE_ENV=DEV
PORT=1801
LOGLEVEL="debug"
CONNECTION_STRING='mongodb://username:password@hostname/database'
DB_TYPE="MONGODB"
DB_DEPENDECIES=false
#CONNECTION_STRING='postgresql://username:password@localhost:5432/nomedeldatabase'
LOG_API_KEY=""
LOG_URL=""
SECRET_KEY=""
JWT_SECRET=""
ALLOWED_ORIGINS="http://localhost:4200,https://yourdomain.com"
# Rate limiting: numero massimo di richieste per IP (default: 1000)
RATE_LIMIT_MAX=1000
# Rate limiting: finestra temporale in millisecondi (default: 60000 = 1 minuto)
# RATE_LIMIT_WINDOW_MS=60000
# Rate limiting dedicato autenticazione (login/registrazione/recoverPassword)
# Contano SOLO i tentativi falliti. Default: 50 per IP, 10 per account, finestra 15 min
# AUTH_RATE_LIMIT_IP_MAX=50
# AUTH_RATE_LIMIT_ACCOUNT_MAX=10
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# failToBan (anti-bruteforce su login): conta SOLO i tentativi di login falliti
# (i 401 anonimi di un utente non autenticato NON sono "fallimenti").
# Default: 8 tentativi in 10 minuti, poi backoff 30s/60s/120s/240s max 300s
# FAILED_ATTEMPT_WINDOW_MS=600000
# FAILED_ATTEMPT_MAX=8
# FAILED_ATTEMPT_HARD_BAN=15
# URL pubblico della SPA (per link nelle email e nei redirect OAuth)
CLIENT_URL="http://localhost:4200"
# Segreto del webhook Stripe (Dashboard -> Developers -> Webhooks -> endpoint secret).
# Senza questo segreto il webhook risponde 400 e nessun evento viene processato.
# Endpoint da configurare nel dashboard: https://<api-host>/api/stripe/webhook
# Eventi: checkout.session.completed, checkout.session.expired,
#         payment_intent.succeeded, payment_intent.payment_failed,
#         charge.refunded, charge.dispute.created, charge.dispute.closed,
#         charge.dispute.funds_withdrawn
STRIPE_WEBHOOK_SECRET=""
APP_NAME="Pintour"
# IP ammessi a chiamare POST /api/momap/cron (lista separata da virgole).
# ATTENZIONE pentest: se vuoto, l'endpoint e' APERTO a meno che sia configurato
# un MOMAP_CRON_SECRET corretto (fail-closed).
MOMAP_ALLOWED_IPS=""
# Segreto opzionale per invocare /api/momap/cron senza configurare IP:
# il server (cron/scheduler) invia l'header "x-cron-secret: <valore>".
# Genera un valore lungo casuale, es: openssl rand -hex 32
# MOMAP_CRON_SECRET=

# Microsoft / Outlook (passport-microsoft)
# Registra l'app su https://portal.azure.com -> Microsoft Entra ID -> App registrations
# Tipi di account: "Account in qualsiasi directory organizzativa e account Microsoft personali"
# Redirect URI (Web): uguale a MICROSOFT_CALLBACK_URL (es. http://localhost:1801/microsoft/auth/callback)
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_CALLBACK_URL="http://localhost:1801/microsoft/auth/callback"

# Facebook (passport-facebook): il provider copre anche gli utenti Instagram
# (il Login nativo Instagram per app consumer è stato dismesso da Meta a fine 2024).
# Registra l'app su https://developers.facebook.com/apps  -> tipo Business
#   - Aggiungere il prodotto "Facebook Login"
#   - Impostare "Valid OAuth Redirect URIs" = FACEBOOK_CALLBACK_URL
#   - Dev-mode: testabile dai soli ruoli dell'app (admin/tester); pubblico = App Review
# Redirect URI (Web): es. http://localhost:1801/api/facebook/auth/callback (DEV)
#                      https://test.pintourbus.com/api/facebook/auth/callback (TEST)
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
FACEBOOK_CALLBACK_URL="http://localhost:1801/api/facebook/auth/callback"

# Spotify (passport-spotify): per sviluppo/test basta la dashboard
# https://developer.spotify.com/dashboard  -> "Create app"
#   - Redirect URIs = SPOTIFY_CALLBACK_URL
#   - Which API/SDKs are you planning?: "Web API"
#   - Dev-mode: max 25 utenti in "User Management"; pubblico = Quota Mode (review)
# Redirect URI (Web): es. http://localhost:1801/api/spotify/auth/callback (DEV)
#                      https://test.pintourbus.com/api/spotify/auth/callback (TEST)
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
SPOTIFY_CALLBACK_URL="http://localhost:1801/api/spotify/auth/callback"

# Nota Instagram: NON esiste un "Accedi con Instagram" per app consumatrici dal
# 4/12/2024 (Basic Display API rimossa da Meta); l'unico flusso residuo è il
# "Business Login", pensato per gestire contenuti di account PROFESSIONALI
# proprietari (nessuna email, nessun SSO). L'utenza Instagram è quindi gestita
# dal bottone Facebook (account Meta collegati a Instagram).
 