## STEP 4 — Endpoint batch (Backend)

### 4.1 Aggiungere metodo al BookingsService

**File:** `back/src/components/services/bookingServices.ts`

Nuovo metodo `insertCartBooking`:

```typescript
async insertCartBooking(tickets: any[], userId: string) {
  let session: ClientSession = client.startSession();
  let cartId = "CART" + Date.now() + Math.random().toString(36).substr(2, 9);

  try {
    await this.removeExpiredPendingBookings();
    let booking = await this.removePendingBooking(userId);
    if (booking.length >= 3) throw new Error("str_error_pending_booking");

    // Validare TUTTI i ticket prima di creare qualsiasi booking
    for (let ticket of tickets) {
      await this.checkPriceAndTime(ticket);
    }

    session.startTransaction();
    let user = await this.userServices.getUserById(userId);
    let books: booking[] = [];

    // Creare un booking per OGNI tratta (ogni tratta = 1 biglietto separato)
    for (let ticket of tickets) {
      ticket.userId = userId;
      ticket.cartId = cartId;

      if (user) {
        ticket.user = {
          id: userId,
          name: user.details?.name,
          mail: user.email,
          phone: user.details?.phone,
        };
      }

      let book = new booking(ticket);

      // Verificare posti disponibili per ogni tratta
      let numeroPosti: any = await this.availableSeats(
        book.date, book.routeId, book.scheduleId,
        book.from.id, book.to.id, session
      );

      if (book.seats > numeroPosti.availableSeats) {
        throw new Error("str_error_seats");
      }
      if (book.luggage > 0 && book.luggage > numeroPosti.availableLuggage) {
        throw new Error("str_error_luggage");
      }

      await this.bookingDao.insertBooking(book, session);
      books.push(book);
    }

    await session.commitTransaction();
  } catch (error) {
    await session.abortTransaction();
    await session.endSession();
    throw error;
  }

  await session.endSession();

  // Creare UNA SOLA sessione Stripe con tutti i line_items
  try {
    let paymentSession: any = await this.paymentServices.calculateCartPayment(books, cartId);
    let url: any = "";
    switch (paymentSession.type) {
      case "stripe":
        // Aggiornare ogni booking con le info pagamento e il cartId
        for (let book of books) {
          await this.bookingDao.updateCartPaymentInfo(
            paymentSession.type,
            paymentSession.other,
            book.numberOfTickets,
            cartId,
            paymentSession.paymentIntentId
          );
        }
        url = paymentSession.other.url;
        break;
    }
    if (url == "") {
      throw new Error("str_error_payment");
    }
    return url;
  } catch (error) {
    // Se il pagamento fallisce, cancellare tutti i booking del carrello
    for (let book of books) {
      await this.bookingDao.deleteBooking(book.numberOfTickets);
    }
    throw error;
  }
}
```

### 4.2 Aggiungere metodo al PaymentServices

**File:** `back/src/components/services/paymentServices.ts`

```typescript
async calculateCartPayment(books: booking[], cartId: string):
  Promise<{ type: string; other: any; paymentIntentId?: string }> {
  try {
    let paymentMethods: any = await this.paymentDao.getPaymentMethod();
    switch (paymentMethods.type) {
      case "stripe":
        let session: any = await this.stripeServices.getCartPaymentSession(books, cartId);
        return {
          type: "stripe",
          other: session,
          paymentIntentId: session.payment_intent,
        };
    }
  } catch (error) {
    throw error;
  }
  return { type: "error", other: "none" };
}
```

### 4.3 Aggiungere metodo allo StripeServices

**File:** `back/src/components/services/stripeServices.ts`

Nuovo metodo `getCartPaymentSession` che crea **una sola** Checkout Session con tutti i `line_items` di tutte le tratte:

```typescript
async getCartPaymentSession(books: booking[], cartId: string) {
  try {
    let items: any[] = [];

    // Per OGNI booking, aggiungere i suoi ticket come line_items separati
    for (let book of books) {
      let ticketData = book.date.split("-").reverse().join("/");
      let routeLabel = `${getLocalizedName(book.name, book.lng)} - ` +
        `${book.from.name} (${book.from.stopTime}) -> ` +
        `${book.to.name} (${book.to.stopTime}) - ${ticketData}`;

      // Aggiungere ogni tipo di biglietto della tratta
      for (let item of book.ticketTypes) {
        items.push({
          price_data: {
            currency: "eur",
            product_data: {
              name: getLocalizedName(item.name, book.lng) + " - " +
                    getLocalizedName(item.description, book.lng),
              description: routeLabel,
            },
            unit_amount: item.cost * 100,
          },
          quantity: item.count,
        });
      }

      // Aggiungere bagagli extra se presenti
      if (book.luggage > 0) {
        items.push({
          price_data: {
            currency: "eur",
            product_data: {
              name: getStripeLabel("extraLuggage", book.lng),
              description: getStripeLabel("extraLuggageDesc", book.lng) +
                            " - " + routeLabel,
            },
            unit_amount: 2 * 100,
          },
          quantity: book.luggage,
        });
      }
    }

    // Metadata: contenere tutti i booking_id separati da virgola
    const bookingIds = books.map(b => b.numberOfTickets).join(",");
    const firstBook = books[0];

    const session = await this.stripe.checkout.sessions.create({
      payment_method_types: ["card"],
      customer_email: firstBook.user.mail,
      line_items: items,
      mode: "payment",
      payment_intent_data: {
        capture_method: "manual",
        metadata: {
          cart_id: cartId,
          booking_ids: bookingIds,
          departure: books.map(b => b.date).join(", "),
          user: firstBook.user.name,
          mail: firstBook.user.mail,
        },
        description: `Cart ${cartId} - ${books.length} tratte`,
      },
      success_url: `${env.CLIENT_URL}/payment/stripe/success/cart/${cartId}`,
      cancel_url: `${env.CLIENT_URL}/payment/stripe/cancel/cart/${cartId}`,
      metadata: {
        cart_id: cartId,
        booking_ids: bookingIds,
        departure: books.map(b => b.date).join(", "),
        userId: firstBook.user.id,
        user: firstBook.user.name,
        lng: firstBook.lng,
        mail: firstBook.user.mail,
      },
      expires_at: Math.floor(Date.now() / 1000) + 60 * 30,
    });

    return session;
  } catch (error) {
    logger.error("Impossibile creare la sessione di pagamento carrello", error);
    throw new Error("str_error_payment");
  }
}
```

