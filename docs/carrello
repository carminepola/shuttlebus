## STEP 5 — Webhook Stripe (il punto critico)

### 5.1 Modificare il webhook per gestire il carrello

**File:** `back/src/api/stripe.ts`

Nel caso `checkout.session.completed`, aggiungere la logica per gestire sia il flusso singolo (esistente) sia quello carrello:

```typescript
case "checkout.session.completed": {
  const session = event.data.object as Stripe.Checkout.Session;
  const metadata = session.metadata;

  // Verificare se e' un carrello (ha cart_id)
  const cartId = metadata?.cart_id;
  const paymentIntentId = session.payment_intent as string;

  if (cartId) {
    // === FLUSSO CARRELLO ===
    let bookingServices = new BookingsServices(db);

    // Recuperare tutti i booking con questo cartId
    let bookings = await bookingServices.getBookingsByCartId(cartId);

    if (bookings && bookings.length > 0) {
      // Confermare TUTTI i booking del carrello
      for (let booking of bookings) {
        await bookingServices.confirmBooking(
          booking.numberOfTickets,
          session.id
        );
        await bookingServices.updatePaymentIntentId(
          booking.numberOfTickets,
          paymentIntentId
        );
      }

      if (paymentIntentId) {
        const paymentIntent = await stripe.paymentIntents.retrieve(paymentIntentId);

        if (paymentIntent.status === "requires_capture") {
          let captureResult = await stripe.paymentIntents.capture(paymentIntentId);

          if (captureResult.status !== "succeeded") {
            // Scadere TUTTI i booking del carrello
            for (let booking of bookings) {
              await bookingServices.expireTicketById(booking.numberOfTickets);
            }
            throw new ErrorModel(400, "str_payment_failed");
          }

          // Inviare conferma per OGNI booking (ogni tratta = biglietto separato)
          for (let booking of bookings) {
            await bookingServices.sendConfirmation(
              booking.numberOfTickets,
              "stripe"
            );
          }
        }
      }
    }
    logger.info(`Pagamento carrello confermato per cartId ${cartId} (${bookings?.length || 0} booking)`);
  } else {
    // === FLUSSO SINGOLO (esistente, invariato) ===
    // ... codice esistente ...
  }
  break;
}
```

### 5.2 Gestire scadenza carrello (checkout.session.expired)

Sempre in `back/src/api/stripe.ts`:

```typescript
case "checkout.session.expired": {
  const session = event.data.object as Stripe.Checkout.Session;
  const cartId = session.metadata?.cart_id;

  if (cartId) {
    let bookingServices = new BookingsServices(db);
    let bookings = await bookingServices.getBookingsByCartId(cartId);
    if (bookings) {
      for (let booking of bookings) {
        await bookingServices.expireTicketById(booking.numberOfTickets);
      }
    }
    logger.info(`Pagamento carrello scaduto per cartId ${cartId}`);
  } else {
    // Flusso singolo esistente
    const bookingId = session.metadata?.booking_id;
    if (bookingId) {
      bookingServices.expireTicketById(bookingId);
    }
  }
  break;
}
```

