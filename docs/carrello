### 2.1 Creare il servizio cart

**Nuovo file:** `front/src/app/services/cart/cart.service.ts`

```typescript
import { Injectable } from '@angular/core';
import { BehaviorSubject } from 'rxjs';

export interface CartItem {
  date: string;
  routeId: string;
  scheduleId: string;
  total: number;
  luggage: number;
  seats: number;
  name: any;
  from: any;
  to: any;
  ticketTypes: any[];
  lng: string;
}

@Injectable({ providedIn: 'root' })
export class CartService {
  private items = new BehaviorSubject<CartItem[]>([]);
  private STORAGE_KEY = 'shuttlebus_cart';

  constructor() {
    const saved = localStorage.getItem(this.STORAGE_KEY);
    if (saved) {
      try {
        this.items.next(JSON.parse(saved));
      } catch {
        this.items.next([]);
      }
    }
  }

  getItems(): BehaviorSubject<CartItem[]> {
    return this.items;
  }

  getItemCount(): number {
    return this.items.value.length;
  }

  addItem(item: CartItem): void {
    const current = this.items.value;
    current.push(item);
    this.persist(current);
  }

  removeItem(index: number): void {
    const current = this.items.value;
    current.splice(index, 1);
    this.persist(current);
  }

  clearCart(): void {
    this.persist([]);
  }

  getTotal(): number {
    return this.items.value.reduce((sum, item) => sum + item.total, 0);
  }

  private persist(items: CartItem[]): void {
    this.items.next(items);
    localStorage.setItem(this.STORAGE_KEY, JSON.stringify(items));
  }
}
```

